---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

const recentPosts = (await getSortedPosts()).slice(0, 3);
---

<MainGridLayout
    title="主页"
    description="youki 的个人主页与技术博客，记录 AI、工具、云服务和持续构建。"
>
    <div class="flex flex-col gap-4">
        <section class="card-base overflow-hidden px-6 py-8 md:px-10 md:py-12">
            <p class="text-sm font-bold uppercase tracking-[0.24em] text-[var(--primary)]">YOUKI / DIGITAL GARDEN</p>
            <h1 class="mt-4 text-3xl font-bold leading-tight text-90 md:text-5xl">
                把想法做成<br class="md:hidden" />可以访问的东西。
            </h1>
            <p class="mt-5 max-w-2xl text-base leading-8 text-75 md:text-lg">
                这里记录我正在学习、使用和构建的东西：AI 工具、全栈开发、服务器运维，以及一些还没有归类的想法。
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
                <a href="/blog/" class="btn-regular rounded-lg px-5 py-3 font-bold">
                    <Icon name="material-symbols:menu-book-outline-rounded" class="mr-2 inline-block align-[-3px] text-lg" />
                    阅读博客
                </a>
                <a href="#projects" class="btn-card rounded-lg px-5 py-3 font-bold text-[var(--primary)]">
                    查看项目
                </a>
            </div>
        </section>

        <section id="projects" class="card-base px-6 py-7 md:px-8">
            <div class="flex items-end justify-between gap-4">
                <div>
                    <p class="text-sm font-bold uppercase tracking-[0.18em] text-[var(--primary)]">Projects</p>
                    <h2 class="mt-2 text-2xl font-bold text-90">正在做什么</h2>
                </div>
                <span class="hidden text-sm text-50 sm:block">持续构建，持续记录</span>
            </div>

            <div class="mt-6 grid gap-4 md:grid-cols-3">
                <a href="/blog/" class="group rounded-xl border border-black/10 p-5 transition hover:-translate-y-1 hover:border-[var(--primary)] dark:border-white/10">
                    <div class="flex items-center justify-between">
                        <Icon name="material-symbols:article-outline-rounded" class="text-2xl text-[var(--primary)]" />
                        <Icon name="material-symbols:arrow-outward-rounded" class="text-lg opacity-40 transition group-hover:translate-x-1 group-hover:-translate-y-1" />
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-90">技术博客</h3>
                    <p class="mt-2 text-sm leading-6 text-75">记录前端、后端、AI 编程、Docker、网络和服务器实践。</p>
                </a>

                <a href="https://youpin.youki.me/" class="group rounded-xl border border-black/10 p-5 transition hover:-translate-y-1 hover:border-[var(--primary)] dark:border-white/10">
                    <div class="flex items-center justify-between">
                        <Icon name="material-symbols:query-stats-rounded" class="text-2xl text-[var(--primary)]" />
                        <Icon name="material-symbols:arrow-outward-rounded" class="text-lg opacity-40 transition group-hover:translate-x-1 group-hover:-translate-y-1" />
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-90">悠悠有品</h3>
                    <p class="mt-2 text-sm leading-6 text-75">饰品交易分析工具，正式入口计划迁移到 youpin.youki.me。</p>
                </a>

                <div class="rounded-xl border border-dashed border-black/15 p-5 dark:border-white/15">
                    <div class="flex items-center justify-between">
                        <Icon name="material-symbols:auto-awesome-rounded" class="text-2xl text-[var(--primary)]" />
                        <span class="rounded-full bg-[var(--primary)]/15 px-2.5 py-1 text-xs font-bold text-[var(--primary)]">计划中</span>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-90">LikeYou</h3>
                    <p class="mt-2 text-sm leading-6 text-75">AI 旅行规划项目，后续计划部署到 travel.youki.me。</p>
                </div>
            </div>
        </section>

        <section class="card-base px-6 py-7 md:px-8">
            <div class="flex items-end justify-between gap-4">
                <div>
                    <p class="text-sm font-bold uppercase tracking-[0.18em] text-[var(--primary)]">Writing</p>
                    <h2 class="mt-2 text-2xl font-bold text-90">最近文章</h2>
                </div>
                <a href="/blog/" class="btn-plain rounded-lg px-3 py-2 text-sm font-bold text-[var(--primary)]">查看全部 →</a>
            </div>

            <div class="mt-5 divide-y divide-black/10 dark:divide-white/10">
                {recentPosts.map((post) => (
                    <a href={getPostUrlBySlug(post.id)} class="group block py-4 first:pt-0 last:pb-0">
                        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                            <h3 class="text-lg font-bold text-90 transition group-hover:text-[var(--primary)]">{post.data.title}</h3>
                            <time class="shrink-0 text-sm text-50" datetime={post.data.published.toISOString()}>
                                {post.data.published.toLocaleDateString("zh-CN")}
                            </time>
                        </div>
                        <p class="mt-1 line-clamp-2 text-sm leading-6 text-75">{post.data.description}</p>
                    </a>
                ))}
            </div>
        </section>
    </div>
</MainGridLayout>
